{
  "schemaVersion": 1,
  "id": "vs_eureka",
  "version": "${version}",
  "name": "Eureka Armada",
  "description": "Eureka with a crew, a gundeck and pirates \u2014 an unofficial Fabric mod built on Valkyrien Skies 2.",
  "authors": [
    "ewoudje",
    "Tri0de",
    "Rubydesic",
    "millennIumAMbiguity"
  ],
  "contributors": [
    "Copper",
    "Anarava",
    "VS Discord",
    "Eminai-LeoVinci"
  ],
  "contact": {
    "homepage": "https://github.com/Eminai-LeoVinci/Eureka-Ships",
    "sources": "https://github.com/Eminai-LeoVinci/Eureka-Ships",
    "issues": "https://github.com/Eminai-LeoVinci/Eureka-Ships/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/vs_eureka/icon.png",
  "environment": "*",
  "entrypoints": {
